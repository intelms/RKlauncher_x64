    CONTROL         "", IDC_LBL_ALPHA_EDGE, TRACKBAR_CLASSW, TBS_AUTOTICKS | WS_TABSTOP, 129, 92, 117, 15
    LTEXT           "Shadow Color:", -1, 20, 112, 50, 8
