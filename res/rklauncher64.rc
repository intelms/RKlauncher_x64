    CONTROL         "", IDC_LBL_ALPHA_SHADOW, TRACKBAR_CLASSW, TBS_AUTOTICKS | WS_TABSTOP, 129, 110, 117, 15
    LTEXT           "Opacity", -1, 177, 125, 25, 8
    AUTOCHECKBOX    "Hide Label", IDC_LBL_HIDE, 73, 140, 50, 10
    AUTOCHECKBOX    "Fade Label", IDC_LBL_FADE, 129, 140, 60, 10
    GROUPBOX        "Preview", IDC_LBL_PREVIEW, 7, 160, 246, 46
